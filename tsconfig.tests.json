{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": ".test-build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/shared/**/*.ts",
    "src/main/csgo-extended.ts",
    "src/main/gsi/latest-frame-processor.ts",
    "src/main/gsi/match-runtime.ts",
    "src/main/gsi/utility-replay-capture.ts",
    "src/main/intermission-next/test-mode.ts",
    "tests/**/*.ts"
  ]
}
