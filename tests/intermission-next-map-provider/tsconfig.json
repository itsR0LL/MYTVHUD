{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "../..",
    "outDir": ".build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "../../src/shared/**/*.ts",
    "../../src/main/intermission-next/map-media/**/*.ts",
    "../../src/main/intermission-next/state/**/*.ts",
    "./**/*.test.ts"
  ],
  "exclude": ["./.build"]
}
